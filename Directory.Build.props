<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IceyFoxes/ClipAsk</RepositoryUrl>
    <Copyright>Copyright (c) 2026 IceyFoxes and ClipAsk contributors</Copyright>
  </PropertyGroup>
</Project>
