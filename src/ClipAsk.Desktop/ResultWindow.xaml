<Window x:Class="ClipAsk.Desktop.ResultWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipAsk" Icon="pack://application:,,,/Assets/clipask.ico" Width="420" Height="228"
        MinWidth="360" MinHeight="220" WindowStyle="None" ResizeMode="CanResize"
        ShowActivated="False" ShowInTaskbar="True" Topmost="True" SizeChanged="WindowSizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Aptos Display, Segoe UI Variable Display, Segoe UI"
        Background="#181B20" Foreground="#F2F4F7" KeyDown="WindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5CBD4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#2B3038" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#383E48" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#78A9FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#3478D4" />
            <Setter Property="BorderBrush" Value="#5592E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3F85E1" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#2A67B8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#B9D4FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionsContextMenu" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#242830" />
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="BorderBrush" Value="#46505D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontFamily" Value="Aptos, Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionsMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="188" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Margin="20,0,0,0"
                                           Foreground="#AEB6C2"
                                           Text="{TemplateBinding InputGestureText}"
                                           VerticalAlignment="Center" />
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="2"
                                      Width="5"
                                      Height="9"
                                      Margin="16,0,2,0"
                                      Fill="#AEB6C2"
                                      Stretch="Fill"
                                      Data="M0,0 L5,4.5 L0,9 Z"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center" />
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       HorizontalOffset="-2"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right"
                                       PopupAnimation="Fade">
                                    <Border Background="#242830"
                                            BorderBrush="#46505D"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#343A44" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#343A44" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#737B87" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionsMenuSeparator" TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Margin="10,4" Background="#3A414C" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" Background="#F7181B20" BorderBrush="#3CFFFFFF" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="TitleBar" Grid.Row="0" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="HeaderMouseDown" Background="Transparent">
            <TextBlock Text="ClipAsk" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontFamily="Aptos Display, Segoe UI Variable Display, Segoe UI"
                       FontSize="13" FontWeight="SemiBold" Foreground="#DDE2E9" />
        </Border>
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="*" />
                <RowDefinition x:Name="LayoutGapRow" Height="0" />
                <RowDefinition x:Name="SecondRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="*" />
                <ColumnDefinition x:Name="LayoutGapColumn" Width="0" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewContainer" Background="#0E1014" CornerRadius="8" ClipToBounds="True" Visibility="Collapsed"
                    MouseRightButtonUp="CapturedImageRightButtonUp"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                       AutomationProperties.Name="Captured screenshot preview" />
            </Border>

            <Grid x:Name="AnswerPane">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="AnswerTopRow" Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="InstructionComposer" Grid.Row="0" Height="40"
                        Background="#242830" BorderBrush="#46505D" BorderThickness="1"
                        CornerRadius="7" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="InstructionTextBox" MaxLength="2000"
                                     Background="Transparent" Foreground="#F2F4F7" CaretBrush="#F2F4F7"
                                     BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"
                                     FontFamily="Aptos, Segoe UI Variable Text, Segoe UI" FontSize="13"
                                     TextChanged="InstructionTextChanged" KeyDown="InstructionKeyDown"
                                     AutomationProperties.Name="Instruction for this selection" />
                            <TextBlock x:Name="InstructionPlaceholder" Text="What should ClipAsk do?"
                                       Margin="11,0,0,0" VerticalAlignment="Center" Foreground="#8993A1"
                                       IsHitTestVisible="False" FontFamily="Aptos, Segoe UI Variable Text, Segoe UI"
                                       FontSize="13" />
                        </Grid>
                        <Button x:Name="InstructionSendButton" Grid.Column="1" Content="Send"
                                Style="{StaticResource PrimaryButton}" Margin="6,3,3,3" Padding="12,4"
                                MinHeight="32" IsEnabled="False" Click="InstructionSendClick"
                                ToolTip="Analyze this selection" AutomationProperties.Name="Analyze this selection" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <RichTextBox x:Name="AnswerDocument" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0" Background="Transparent" Foreground="#F2F4F7"
                                 Padding="0" FontSize="15" />
                    <StackPanel x:Name="HintPanel" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <TextBlock x:Name="HintText" Text="Select anything on screen with Ctrl+Alt+S." TextWrapping="Wrap"
                                   Foreground="#AEB6C2" FontSize="14" />
                        <ProgressBar x:Name="ActivityBar" IsIndeterminate="True" Width="96" Height="2" Margin="0,12,0,0"
                                     HorizontalAlignment="Left" Foreground="#78A9FF" Background="#313740" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="Footer" Grid.Row="2" Margin="0,10,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="#AEB6C2" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="PrimaryActionButton" Grid.Column="1" Content="Connect ChatGPT" Style="{StaticResource PrimaryButton}" Click="PrimaryActionClick" />
                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="ActionBar" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                Background="Transparent" BorderThickness="0" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StopButton" Style="{StaticResource IconButton}" Click="StopClick"
                        Visibility="Collapsed" ToolTip="Stop response" AutomationProperties.Name="Stop response">
                    <Canvas Width="16" Height="16"><Rectangle Canvas.Left="3" Canvas.Top="3" Width="10" Height="10" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RadiusX="1" RadiusY="1" /></Canvas>
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Click="CopyAnswerClick"
                        IsEnabled="False" ToolTip="Copy response" AutomationProperties.Name="Copy response">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="5" Canvas.Top="5" Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" RadiusX="1" RadiusY="1" />
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,11 L2,2 L11,2" />
                    </Canvas>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Click="MoreClick"
                        ToolTip="More actions" AutomationProperties.Name="More actions">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="1" Canvas.Top="6.75" Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Ellipse Canvas.Left="6.75" Canvas.Top="6.75" Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Ellipse Canvas.Left="12.5" Canvas.Top="6.75" Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ActionsMenu" Style="{StaticResource ActionsContextMenu}">
                            <MenuItem Header="New capture" InputGestureText="Ctrl+Alt+S" Click="CaptureClick" Style="{StaticResource ActionsMenuItem}" />
                            <MenuItem x:Name="CopyImageItem" Header="Copy image" Click="CopyImageClick" Style="{StaticResource ActionsMenuItem}" />
                            <MenuItem x:Name="SaveImageItem" Header="Save image as…" Click="SaveImageClick" Style="{StaticResource ActionsMenuItem}" />
                            <MenuItem x:Name="AnswerAgainItem" Header="Analyze again" Click="AnswerClick" Style="{StaticResource ActionsMenuItem}" />
                            <MenuItem Header="Response options…" Click="AnswerOptionsClick" Style="{StaticResource ActionsMenuItem}" />
                            <Separator Style="{StaticResource ActionsMenuSeparator}" />
                            <MenuItem x:Name="StartupItem" Header="Start ClipAsk on startup" Click="StartupClick" Style="{StaticResource ActionsMenuItem}" />
                            <MenuItem x:Name="ConnectionItem" Header="Connect ChatGPT" Click="ConnectClick" Style="{StaticResource ActionsMenuItem}" />
                            <MenuItem Header="Details" Style="{StaticResource ActionsMenuItem}">
                                <MenuItem x:Name="AccountDetailsItem" Header="Disconnected" IsEnabled="False" Style="{StaticResource ActionsMenuItem}" />
                                <MenuItem x:Name="ModelDetailsItem" Header="Model: Automatic (resolved per capture)" IsEnabled="False" Style="{StaticResource ActionsMenuItem}" />
                                <MenuItem x:Name="UsageDetailsItem" Header="Usage: unavailable" IsEnabled="False" Style="{StaticResource ActionsMenuItem}" />
                                <MenuItem x:Name="ResetDetailsItem" Header="Reset: —" IsEnabled="False" Style="{StaticResource ActionsMenuItem}" />
                            </MenuItem>
                            <Separator Style="{StaticResource ActionsMenuSeparator}" />
                            <MenuItem Header="About ClipAsk &amp; licenses…" Click="AboutClick" Style="{StaticResource ActionsMenuItem}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Click="MinimizeClick"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Canvas Width="16" Height="16">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,12.5 L13,12.5" />
                    </Canvas>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Click="CloseClick"
                        ToolTip="Close to tray" AutomationProperties.Name="Close to tray">
                    <Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,3 L13,13 M13,3 L3,13" /></Canvas>
                </Button>
            </StackPanel>
        </Border>
        <Path Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Width="12" Height="12" Margin="0,0,5,5" IsHitTestVisible="False"
              Stroke="#68717E" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M1,11 L11,1 M5,11 L11,5 M9,11 L11,9" />
      </Grid>
    </Border>
</Window>
