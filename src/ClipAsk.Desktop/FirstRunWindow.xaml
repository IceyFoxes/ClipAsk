<Window x:Class="ClipAsk.Desktop.FirstRunWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ClipAsk" Icon="pack://application:,,,/Assets/clipask.ico" Width="500" Height="390" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="#181B20" Foreground="#F2F4F7"
        FontFamily="Aptos Display, Segoe UI Variable Display, Segoe UI" KeyDown="WindowKeyDown">
    <Window.Resources>
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#293C58" />
            <Setter Property="Margin" Value="0,1,12,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#3478D4" />
            <Setter Property="BorderBrush" Value="#5592E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Border Background="#181B20" BorderBrush="#596270" BorderThickness="1" CornerRadius="10">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="HeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="Welcome to ClipAsk" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Select something. Ask once. Get back to what you were doing."
                               Margin="0,5,0,0" FontSize="13" Foreground="#AEB6C2" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#AFCFFF" /></Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Press Ctrl+Alt+S" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="The shortcut works while ClipAsk is running in the system tray." Margin="0,3,0,0" Foreground="#AEB6C2" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#AFCFFF" /></Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Drag with the button that matches your intent" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Foreground="#AEB6C2" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="#F2F4F7">Left-drag</Run><Run Text=" opens a prompt so you can add an instruction.  " /><Run FontWeight="SemiBold" Foreground="#F2F4F7">Right-drag</Run><Run Text=" asks about the selection immediately." />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#AFCFFF" /></Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Your selection is copied automatically" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Every valid capture goes to the Windows clipboard. Use the copy button to copy an answer."
                               Margin="0,3,0,0" Foreground="#AEB6C2" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Tip: the ••• menu has response options and startup settings."
                           FontSize="11" Foreground="#8993A1" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Start clipping" IsDefault="True" Click="ContinueClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
