<Window x:Class="ClipAsk.Desktop.AnswerOptionsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Response options" Icon="pack://application:,,,/Assets/clipask.ico" Width="460" Height="380" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#181B20" Foreground="#F2F4F7"
        FontFamily="Aptos Display, Segoe UI Variable Display, Segoe UI" KeyDown="WindowKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="Background" Value="#2B3038" />
            <Setter Property="BorderBrush" Value="#46505D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>
    <Border Background="#181B20" BorderBrush="#596270" BorderThickness="1" CornerRadius="8">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Response options" FontSize="16" FontWeight="SemiBold" MouseLeftButtonDown="HeaderMouseDown" />

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="Model" FontSize="12" Foreground="#AEB6C2" Margin="0,0,0,6" />
                <ComboBox x:Name="ModelBox" Height="34" Padding="8,4" Background="#242830" Foreground="#171B22"
                          BorderBrush="#46505D" AutomationProperties.Name="Model used for responses" />
                <TextBlock x:Name="ModelHelpText" Margin="0,7,0,0" FontSize="11" LineHeight="16"
                           Foreground="#8993A1" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Default instruction for automatic captures" FontSize="12" Foreground="#AEB6C2" Margin="0,16,0,6" />
            <TextBox x:Name="InstructionBox" Grid.Row="3" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="10,8" Background="#242830" Foreground="#F2F4F7"
                     BorderBrush="#46505D" CaretBrush="#F2F4F7"
                     AutomationProperties.Name="Default response instruction" />

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Applies to future automatic analyses in this session" FontSize="11" Foreground="#8993A1" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Cancel" IsCancel="True" Click="CancelClick" />
                <Button Grid.Column="2" Content="Save" IsDefault="True" Background="#3478D4" BorderBrush="#5592E1" Click="SaveClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
