<Window x:Class="ClipAsk.Desktop.AboutWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ClipAsk" Width="470" Height="390" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Background="#181B20" Foreground="#F2F4F7"
        FontFamily="Aptos Display, Segoe UI Variable Display, Segoe UI" KeyDown="WindowKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="Background" Value="#2B3038" />
            <Setter Property="BorderBrush" Value="#46505D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>
    <Border Background="#181B20" BorderBrush="#596270" BorderThickness="1" CornerRadius="10">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="HeaderMouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ClipAsk" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="12" Foreground="#8993A1" />
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Click="CloseClick" Padding="10,5" MinWidth="60" />
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,22,0,0" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                       Text="A lightweight Windows utility for selecting part of your screen and asking ChatGPT about it." />

            <Border Grid.Row="2" Margin="0,18,0,0" Padding="14,12" Background="#22262D" BorderBrush="#3B434E" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Privacy and account" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" Foreground="#AEB6C2" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                               Text="ClipAsk uses the official managed ChatGPT sign-in and stores no API key. Captures remain local until a completed selection triggers or requests an answer. Requests count toward your ChatGPT account usage." />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="Free and open-source software" FontWeight="SemiBold" />
                <TextBlock x:Name="LicenseSummaryText" Margin="0,5,0,0" Foreground="#AEB6C2" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                           Text="ClipAsk is licensed under GNU GPL-3.0-only. Bundled components retain their own licenses; full notices are included with the app." />
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="GPL license" Click="LicenseClick" />
                <Button Grid.Column="2" Content="Third-party notices" Click="NoticesClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
